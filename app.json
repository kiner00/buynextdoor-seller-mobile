{
  "expo": {
    "name": "BuyNextDoor Seller",
    "slug": "buynextdoor-seller",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bndseller",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.buynextdoor.seller",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan an order slip or product label to pull it up instantly."
      }
    },
    "android": {
      "package": "ph.buynextdoor.seller",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#008819"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan an order slip or product label to pull it up instantly."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.staging.buynextdoor.ph"
    }
  }
}
