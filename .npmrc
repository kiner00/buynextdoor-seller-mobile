# Expo SDK 57 ships a version skew inside its own tree: expo-router pulls
# react-dom@19.2.8, which peer-requires react@^19.2.8, while Expo pins
# react@19.2.3. npm's strict peer resolution refuses the install even though
# react-dom is only used by expo-router's web target, which we don't ship.
# Without this, `npm install <anything>` fails on a clean checkout.
legacy-peer-deps=true
